# BeFit backend configuration — TEMPLATE
#
# Copy to .env and fill in. NEVER commit .env.
# Every key below stays on the server. None of them ever ship in the mobile app.

# ---- Required ----

# MongoDB Atlas → cloud.mongodb.com → Connect → Drivers
MONGODB_URI=
MONGODB_DB=befit

# Signs your login tokens. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=

# Coach chat, voice→food parsing, body-scan OCR → aistudio.google.com/apikey
GEMINI_API_KEY=

# Western/generic foods with full micronutrient panels → fdc.nal.usda.gov/api-key-signup
USDA_FDC_API_KEY=


# ---- Optional ----

# Voice logging in Tamil/Hindi/code-mixed speech → dashboard.sarvam.ai
SARVAM_API_KEY=

# OCR backup if Gemini quota runs out → GCP Console (needs billing enabled)
GOOGLE_VISION_API_KEY=

# Grounding search if AI nutrition estimates prove unreliable → tavily.com
TAVILY_API_KEY=


# ---- Model + client config (safe defaults, no secrets) ----

GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_UTILITY_MODEL=gemini-3.5-flash-lite
SARVAM_STT_MODEL=saarika:v2.5

# Open Food Facts asks API users to identify themselves. No key needed.
OPENFOODFACTS_USER_AGENT=BeFit/1.0 (your-email@example.com)
